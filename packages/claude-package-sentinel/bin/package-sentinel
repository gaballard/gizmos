#!/usr/bin/env -S node --experimental-strip-types
// `package-sentinel` - added to the Bash tool's PATH while the plugin is
// enabled (plugin/bin/). Delegates to the shared CLI at the plugin root.
// --experimental-strip-types loads the .ts CLI unflagged on Node >=22.18 and
// flagged-but-working on 22.6+; the flag is a no-op where stripping is default.
import { main } from '../cli.ts';

process.exitCode = await main(process.argv.slice(2));
